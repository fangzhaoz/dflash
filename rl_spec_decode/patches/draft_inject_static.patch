+    def _inject_independent_draft_weights(self):
+        """STATIC-REAL draft injection (verl patch, WRITE-hook; NOT part of the baselines).
+
+        v0.7.1's update_weights_from_ipc restores only the policy (self.model_runner.model); the
+        sleep(level=2)/wake cycle discards engine weights each step, so an INDEPENDENT draft (DFlash)
+        is never given real weights. Re-load its REAL weights from its OWN checkpoint into the live
+        drafter on every wake. Frozen/static for now (co-training swaps the weight source later).
+        Self-verifying: prints how many draft params were loaded (0 == name mismatch / silent no-op).
+        Does NOT touch the policy, sampling, spec config, or the policy weight-sync.
+        """
+        try:
+            spec = self.model_runner.vllm_config.speculative_config
+            if spec is None or getattr(spec, "method", None) != "dflash":
+                return  # only the independent-draft (dflash) case
+            drafter = getattr(self.model_runner, "drafter", None)
+            draft_model = drafter.model if drafter is not None and hasattr(drafter, "model") else None
+            draft_cfg = getattr(spec, "draft_model_config", None)
+            if draft_model is None or draft_cfg is None:
+                print(f"[DRAFT-INJECT] skip: draft_model={draft_model is not None} "
+                      f"draft_cfg={draft_cfg is not None}", flush=True)
+                return
+            # Load REAL weights from the draft's OWN checkpoint (default load_format=auto),
+            # bypassing the engine's load_format=dummy, and apply to the live drafter.
+            from vllm.config import LoadConfig
+            from vllm.model_executor.model_loader import get_model_loader
+
+            loader = get_model_loader(LoadConfig(load_format="auto"))
+            weights = loader.get_all_weights(draft_cfg, draft_model)
+            loaded = draft_model.load_weights(weights)
+            n_loaded = len(loaded) if loaded is not None else -1
+            # Rebuild the fused KV buffers from the now-real weights (stale if built from dummy).
+            inner = getattr(draft_model, "model", None)
+            rebuilt = False
+            if inner is not None and hasattr(inner, "_build_fused_kv_buffers"):
+                inner._build_fused_kv_buffers()
+                rebuilt = True
+            print(f"[DRAFT-INJECT] loaded {n_loaded} draft params from "
+                  f"{getattr(draft_cfg, 'model', '?')}; buffers_rebuilt={rebuilt}", flush=True)
+        except Exception as e:
+            print(f"[DRAFT-INJECT] FAILED: {type(e).__name__}: {e}", flush=True)
+
     def _update_weights(self, weights: list[tuple[str, torch.Tensor]], peft_config: dict, base_sync_done: bool):
         if peft_config and base_sync_done:
             weights = dict(weights)
