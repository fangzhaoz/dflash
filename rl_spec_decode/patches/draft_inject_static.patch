+    def _inject_independent_draft_weights(self):
+        """STATIC-REAL draft injection (verl patch, WRITE-hook; NOT part of the baselines).
+
+        Re-load the INDEPENDENT (DFlash) draft each wake: (a) its diffusion net from its OWN
+        checkpoint, and (b) its embed_tokens from the TARGET's real embedding (DFlash omits embed
+        from its checkpoint and relies on vLLM sharing the target's, which breaks under
+        load_format=dummy). The target embed is found by name+shape. Self-verifying via norm delta.
+        """
+        try:
+            spec = self.model_runner.vllm_config.speculative_config
+            if spec is None or getattr(spec, "method", None) != "dflash":
+                return
+            drafter = getattr(self.model_runner, "drafter", None)
+            draft_model = drafter.model if drafter is not None and hasattr(drafter, "model") else None
+            draft_cfg = getattr(spec, "draft_model_config", None)
+            if draft_model is None or draft_cfg is None:
+                print(f"[DRAFT-INJECT] skip: draft_model={draft_model is not None} "
+                      f"draft_cfg={draft_cfg is not None}", flush=True)
+                return
+            from vllm.config import LoadConfig
+            from vllm.model_executor.model_loader import get_model_loader
+
+            params = dict(draft_model.named_parameters())
+            before = {n: float(p.detach().float().norm()) for n, p in params.items()}
+            loader = get_model_loader(LoadConfig(load_format="auto"))
+            draft_model.load_weights(loader.get_all_weights(draft_cfg, draft_model))
+            inner = getattr(draft_model, "model", None)
+
+            # Copy the REAL target (policy) input embedding into the draft's embed_tokens. Find the
+            # target embed by name+shape (get_input_embeddings() returns None on this VL model).
+            embed_status = "skip"
+            try:
+                dft_embed = getattr(inner, "embed_tokens", None)
+                if dft_embed is None:
+                    embed_status = "no_draft_embed"
+                else:
+                    want = tuple(dft_embed.weight.shape)
+                    tgt_w = None
+                    for n, p in self.model_runner.model.named_parameters():
+                        if n.endswith("embed_tokens.weight") and tuple(p.shape) == want:
+                            tgt_w = p
+                            break
+                    if tgt_w is not None:
+                        dft_embed.weight.data.copy_(tgt_w.data.to(dft_embed.weight.dtype))
+                        embed_status = "copied"
+                    else:
+                        cand = [n for n, p in self.model_runner.model.named_parameters()
+                                if "embed" in n.lower()]
+                        embed_status = f"no_target_embed want={want} candidates={cand[:5]}"
+            except Exception as ee:
+                embed_status = f"err {type(ee).__name__}: {ee}"
+
+            changed = [n for n, p in params.items()
+                       if abs(float(p.detach().float().norm()) - before[n]) > 1e-6]
+            unchanged = [n for n in before if n not in set(changed)]
+            rebuilt = False
+            if inner is not None and hasattr(inner, "_build_fused_kv_buffers"):
+                inner._build_fused_kv_buffers()
+                rebuilt = True
+            # THE FIX: restore the config-derived buffers that sleep(level=2) zeroed and load_weights
+            # does NOT repopulate (rope caches + attn scales). Without this, the draft is positionally
+            # blind -> ~0% acceptance (the verl symptom). Proven in measure_spec_accept.py mode D.
+            self._sync_draft_buffers(draft_model)
+            print(f"[DRAFT-INJECT] model={getattr(draft_cfg, 'model', '?')} params={len(before)} "
+                  f"changed={len(changed)} unchanged={len(unchanged)} embed={embed_status} "
+                  f"rebuilt={rebuilt}", flush=True)
+            print(f"[DRAFT-INJECT] unchanged_sample={unchanged[:8]}", flush=True)
+        except Exception as e:
+            import traceback
+            print(f"[DRAFT-INJECT] FAILED: {type(e).__name__}: {e}\n{traceback.format_exc()}", flush=True)
+
+    def _sync_draft_buffers(self, draft_model):
+        """Restore config-derived draft buffers that sleep(level=2) zeroes and load_weights does
+        NOT repopulate (rope cos_sin_cache, DFlash _rope_cos_sin_cache, attn _k/_q/_v/_prob_scale).
+        Constants computed at init (valid even under dummy); clone them the first time we see them
+        nonzero (CPU, <=256MiB each), copy them back into the zeroed tensors on every wake. Proven
+        in rl_spec_decode/measure_spec_accept.py --mode sleep_wake_inject (0% -> 38.5%/6.78, ==init)."""
+        import torch
+        CAP = 256 * 1024 * 1024
+
+        def state_tensors(root):
+            for mod_name, mod in root.named_modules():
+                for bname, b in list(mod._buffers.items()):
+                    if isinstance(b, torch.Tensor):
+                        yield (mod_name + ".#buf#." + bname, mod, bname, True)
+                for aname, a in list(vars(mod).items()):
+                    if isinstance(a, torch.Tensor) and aname not in mod._buffers:
+                        yield (mod_name + ".#attr#." + aname, mod, aname, False)
+
+        def get_t(owner, attr, is_buf):
+            return owner._buffers[attr] if is_buf else getattr(owner, attr, None)
+
+        def is_zero(t):
+            try:
+                return float(t.detach().float().norm()) == 0.0
+            except Exception:
+                return False
+
+        try:
+            cache = getattr(self, "_draft_buf_cache", None)
+            if cache is None:
+                cache = {}
+                for key, owner, attr, is_buf in state_tensors(draft_model):
+                    t = get_t(owner, attr, is_buf)
+                    if isinstance(t, torch.Tensor) and not is_zero(t) and t.numel() * t.element_size() <= CAP:
+                        cache[key] = t.detach().to("cpu", copy=True)
+                if cache:
+                    self._draft_buf_cache = cache
+                    print(f"[DRAFT-BUF] captured {len(cache)} config-derived buffers (pre-sleep)", flush=True)
+                else:
+                    print("[DRAFT-BUF] WARNING: nothing to capture (hook ran after sleep zeroed "
+                          "buffers); cannot restore by capture -> recompute path needed", flush=True)
+                    return
+            restored = 0
+            for key, owner, attr, is_buf in state_tensors(draft_model):
+                s = cache.get(key)
+                if s is None:
+                    continue
+                t = get_t(owner, attr, is_buf)
+                if isinstance(t, torch.Tensor) and tuple(t.shape) == tuple(s.shape) and is_zero(t):
+                    t.data.copy_(s.to(t.device, t.dtype))
+                    restored += 1
+            print(f"[DRAFT-BUF] restored {restored} wake-zeroed buffers into the live draft", flush=True)
+        except Exception as e:
+            import traceback
+            print(f"[DRAFT-BUF] FAILED: {type(e).__name__}: {e}\n{traceback.format_exc()}", flush=True)
+
     def _update_weights(self, weights: list[tuple[str, torch.Tensor]], peft_config: dict, base_sync_done: bool):
         if peft_config and base_sync_done:
             weights = dict(weights)
