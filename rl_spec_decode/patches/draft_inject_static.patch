+    def _inject_independent_draft_weights(self):
+        """STATIC-REAL draft injection (verl patch, WRITE-hook; NOT part of the baselines).
+
+        Re-load the INDEPENDENT (DFlash) draft's REAL weights from its OWN checkpoint into the live
+        drafter on every wake (v0.7.1 restores only the policy; sleep(level=2) discards the draft).
+        Self-verifying via in-place param-NORM delta: 'changed' = params actually loaded, 'unchanged'
+        = params NOT loaded (the likely-broken ones). Does NOT touch policy/sampling/spec/sync.
+        """
+        try:
+            spec = self.model_runner.vllm_config.speculative_config
+            if spec is None or getattr(spec, "method", None) != "dflash":
+                return
+            drafter = getattr(self.model_runner, "drafter", None)
+            draft_model = drafter.model if drafter is not None and hasattr(drafter, "model") else None
+            draft_cfg = getattr(spec, "draft_model_config", None)
+            if draft_model is None or draft_cfg is None:
+                print(f"[DRAFT-INJECT] skip: draft_model={draft_model is not None} "
+                      f"draft_cfg={draft_cfg is not None}", flush=True)
+                return
+            from vllm.config import LoadConfig
+            from vllm.model_executor.model_loader import get_model_loader
 
+            params = dict(draft_model.named_parameters())
+            before = {n: float(p.detach().float().norm()) for n, p in params.items()}
+            loader = get_model_loader(LoadConfig(load_format="auto"))
+            draft_model.load_weights(loader.get_all_weights(draft_cfg, draft_model))
+            changed = [n for n, p in params.items()
+                       if abs(float(p.detach().float().norm()) - before[n]) > 1e-6]
+            changed_set = set(changed)
+            unchanged = [n for n in before if n not in changed_set]
+            inner = getattr(draft_model, "model", None)
+            rebuilt = False
+            if inner is not None and hasattr(inner, "_build_fused_kv_buffers"):
+                inner._build_fused_kv_buffers()
+                rebuilt = True
+            print(f"[DRAFT-INJECT] model={getattr(draft_cfg, 'model', '?')} params={len(before)} "
+                  f"changed={len(changed)} unchanged={len(unchanged)} rebuilt={rebuilt}", flush=True)
+            print(f"[DRAFT-INJECT] unchanged_sample={unchanged[:8]}", flush=True)
+        except Exception as e:
+            import traceback
+            print(f"[DRAFT-INJECT] FAILED: {type(e).__name__}: {e}\n{traceback.format_exc()}", flush=True)
+
     def _update_weights(self, weights: list[tuple[str, torch.Tensor]], peft_config: dict, base_sync_done: bool):
