+
+    async def _log_spec_decode_metrics(self):
+        """READ-ONLY measurement hook (verl patch, NOT part of the baseline runs).
+
+        Logs per-step in-rollout spec-decode acceptance. vLLM resets these counters on each
+        wake_up (free_cache_engine), so each line reflects THAT step's generation. Uses print()
+        (not logger.info) because this Ray-actor process has no INFO logging handler, so INFO
+        records are dropped. Does NOT alter generation, sampling, spec config, or weight sync.
+        ALWAYS prints a heartbeat. Requires rollout.disable_log_stats=False.
+        """
+        try:
+            def _sum(obj, attr):
+                return int(sum(getattr(obj, attr, []) or []))
 
+            info = {"replica": self.replica_rank}
+            reg = {}
+            try:
+                from prometheus_client import REGISTRY
+                for metric in REGISTRY.collect():
+                    if "spec_decode" in metric.name:
+                        reg[metric.name] = sum(
+                            s.value for s in metric.samples if s.name.endswith("_total")
+                        )
+            except Exception as e:
+                info["registry_err"] = repr(e)
+            acc = {}
+            try:
+                lm = getattr(self.engine, "logger_manager", None)
+                if lm is None:
+                    info["logger_manager"] = None
+                else:
+                    loggers = getattr(lm, "stat_loggers", [])
+                    info["logger_types"] = [type(sl).__name__ for sl in loggers]
+                    for sl in loggers:
+                        sd = getattr(sl, "spec_decoding_logging", None)
+                        if sd is None:
+                            continue
+                        acc = {
+                            "num_drafts": _sum(sd, "num_drafts"),
+                            "num_draft_tokens": _sum(sd, "num_draft_tokens"),
+                            "num_accepted_tokens": _sum(sd, "num_accepted_tokens"),
+                        }
+            except Exception as e:
+                info["acc_err"] = repr(e)
+
+            drafts = reg.get("vllm:spec_decode_num_drafts") or acc.get("num_drafts")
+            draft_tokens = reg.get("vllm:spec_decode_num_draft_tokens") or acc.get("num_draft_tokens")
+            accepted = reg.get("vllm:spec_decode_num_accepted_tokens")
+            if accepted is None:
+                accepted = acc.get("num_accepted_tokens")
+            msg = f">>> SPEC-ACCEPT per-step info={info} registry={reg} accum={acc}"
+            if draft_tokens and accepted is not None and draft_tokens > 0:
+                msg += f" | per_draft_token_acceptance={accepted / draft_tokens:.3%}"
+            if drafts and accepted is not None and drafts > 0:
+                msg += f" | mean_acceptance_length={accepted / drafts + 1.0:.3f}"
+            print(msg, flush=True)
+        except Exception as e:
+            print(f">>> SPEC-ACCEPT hook failed: {e}", flush=True)
+
     async def sleep(self):
+        await self._log_spec_decode_metrics()  # READ-ONLY measurement (verl patch; rl_spec_decode)
         if self.node_rank != 0 or not self.config.free_cache_engine:
             return
 
