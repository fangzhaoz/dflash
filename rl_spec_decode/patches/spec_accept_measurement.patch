+    async def _log_spec_decode_metrics(self):
+        """READ-ONLY measurement hook (verl patch, NOT part of the baseline runs).
+
+        Logs cumulative spec-decode acceptance from the engine's prometheus metrics.
+        Does NOT touch generation, sampling, spec config, or the weight-sync path.
+        Requires rollout.disable_log_stats=False so the PrometheusStatLogger is active.
+        """
+        try:
+            from prometheus_client import REGISTRY
+
+            vals = {}
+            for metric in REGISTRY.collect():
+                if "spec_decode" not in metric.name:
+                    continue
+                total = 0.0
+                for s in metric.samples:
+                    if s.name.endswith("_total"):
+                        total += s.value
+                vals[metric.name] = total
+            if not vals:
+                return  # spec decoding off (e.g. RUN 0) or metrics unavailable
+            drafts = vals.get("vllm:spec_decode_num_drafts")
+            draft_tokens = vals.get("vllm:spec_decode_num_draft_tokens")
+            accepted = vals.get("vllm:spec_decode_num_accepted_tokens")
+            msg = f"[SPEC-ACCEPT replica={self.replica_rank}] cumulative={vals}"
+            if draft_tokens and accepted is not None:
+                msg += f" | per_draft_token_acceptance={accepted / draft_tokens:.3%}"
+            if drafts and accepted is not None:
+                msg += f" | mean_acceptance_length={accepted / drafts + 1.0:.3f}"
+            logger.info(msg)
+        except Exception as e:
+            logger.warning(f"[SPEC-ACCEPT] metric read failed: {e}")
 
     async def sleep(self):
+        await self._log_spec_decode_metrics()  # READ-ONLY measurement (verl patch; rl_spec_decode)
         if self.node_rank != 0 or not self.config.free_cache_engine:
             return
 
